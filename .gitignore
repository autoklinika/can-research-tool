# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# Build and packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments and local settings
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# CAN Research Tool: local sessions and raw captures
sessions/
data/
logs/
_incoming/
*.kme
*.kmf
*.blf
*.asc
*.pcap
*.pcapng
*.trc
*.log
*.csv

# Permit intentionally small test fixtures
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.asc

# Local configuration and machine-specific paths
config/local.json
config/*.local.json
*.user.json

# Vendor binaries, SDK redistributables and native libraries
vendor/
*.dll
*.lib
*.pdb
*.exe

# Generated reports and temporary exports
reports/generated/
exports/
tmp/
temp/

# Secrets, certificates and keys
*.pem
*.key
*.pfx
*.p12
secrets/
